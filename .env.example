# DO NOT EDIT THIS FILE DIRECTLY. Copy its contents into a file named .env in 
# the root directory of this project, and assign values to each environment 
# variable there.
#
# The values for DB_HOST/TEST_DB_HOST, DB_PORT/TEST_DB_PORT, DB_USER/TEST_DB_USER,
# and DB_PASSWORD/TEST_DB_PASSWORD can be obtained by opening a terminal and running:
#   
# npm run create-pg-container-config
#
# followed by:
#
# npm run pg-dev:start
#
# or
#
# npm run pg-test:start
#
# Be sure that Docker is installed and running before executing the pg-dev/pg-test
# commands.
#
# The value for DB_NAME can be whatever you want.
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASSWORD=

TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_USER=
TEST_DB_NAME=
TEST_DB_PASSWORD=